{
  "name": "jet",
  "version": "1.0.0",
  "description": "JET animated isometric city, based on Figma",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "fonts": "node scripts/copy-fonts.mjs",
    "assets": "node scripts/download-assets.mjs",
    "test": "node --test tests/worker.test.js",
    "test:browser": "node --env-file-if-exists=.dev.vars node_modules/@playwright/test/cli.js test",
    "deploy": "wrangler deploy",
    "publish:cloudflare": "node scripts/publish-cloudflare.mjs",
    "build": "node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshio-1126/JET.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/yoshio-1126/JET/issues"
  },
  "homepage": "https://github.com/yoshio-1126/JET#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/reddit-sans": "^5.3.0"
  },
  "private": true
}
